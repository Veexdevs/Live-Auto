{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tiktok-worker.js": {
      "maxDuration": 300
    },
    "api/state.js": {
      "maxDuration": 30
    },
    "api/action.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
