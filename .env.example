# Chave da API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Modelo padrão da OpenRouter (ex: openai/gpt-4o-mini, google/gemini-2.0-flash-001, openrouter/auto)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Usuário do TikTok opcional para conectar ao iniciar (sem @)
TIKTOK_USERNAME=

# Porta do servidor HTTP + WebSocket
PORT=3000
