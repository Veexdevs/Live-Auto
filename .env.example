# Chave da API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Modelo padrão da OpenRouter (ex: openai/gpt-4o-mini, google/gemini-2.0-flash-001, openrouter/auto)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Usuário do TikTok opcional para auto-detectar live (sem @)
TIKTOK_USERNAME=

# Persistência em nuvem opcional para Vercel Serverless (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Porta local do servidor de desenvolvimento
PORT=3000
